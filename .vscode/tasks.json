{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate Ninja files",
            "type": "process",
            "command": "D:\\Tools\\Premake\\premake5.exe",
            "args": ["ninja"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        
