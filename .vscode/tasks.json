{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate Ninja files",
            "type": "process",
            "command": "D:\\premake-5.0.0-windows\\premake5.exe",
            "args": ["ninja"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\ninja.exe",
            "args": ["-C", "build", "-f", "Cpu.ninja", "Cpu_Debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Generate Ninja files",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\ninja.exe",
            "args": ["-C", "build", "-f", "Cpu.ninja", "Cpu_Release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Generate Ninja files",
            "dependsOrder": "sequence",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run Debug",
            "type": "process",
            "command": "${workspaceFolder}/build/bin/Debug/Cpu.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Debug",
            "dependsOrder": "sequence",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run Release",
            "type": "process",
            "command": "${workspaceFolder}/build/bin/Release/Cpu.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Release",
            "dependsOrder": "sequence",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ]
}