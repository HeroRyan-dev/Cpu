# Benchmarks project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule link_gcc
  command = g++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Benchmarks_Debug

cflags_Benchmarks_Debug = -m64 -O0 -g -Wall -Wextra -D"DEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
cxxflags_Benchmarks_Debug = -m64 -O0 -g -Wall -Wextra -std=c++26 -D"DEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
ldflags_Benchmarks_Debug = -m64 -L/usr/lib64
links_Benchmarks_Debug = -lbenchmark -lbenchmark_main
objdir_Benchmarks_Debug = obj/Benchmarks/Debug
targetdir_Benchmarks_Debug = bin/Debug
target_Benchmarks_Debug = Benchmarks.exe

build obj/Benchmarks/Debug/example.o: cxx_gcc ../benchmarks/example.cpp
  cxxflags = $cxxflags_Benchmarks_Debug
build bin/Debug/Benchmarks.exe: link_gcc obj/Benchmarks/Debug/example.o
  ldflags = $ldflags_Benchmarks_Debug
  links = $links_Benchmarks_Debug

# Configuration: Benchmarks_Release

cflags_Benchmarks_Release = -m64 -O3 -g -Wall -Wextra -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O3 -march=x86-64 -flto -mtune=native -fomit-frame-pointer
cxxflags_Benchmarks_Release = -m64 -O3 -g -Wall -Wextra -std=c++26 -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O3 -march=x86-64 -flto -mtune=native -fomit-frame-pointer
ldflags_Benchmarks_Release = -m64 -flto -L/usr/lib64
links_Benchmarks_Release = -lbenchmark -lbenchmark_main
objdir_Benchmarks_Release = obj/Benchmarks/Release
targetdir_Benchmarks_Release = bin/Release
target_Benchmarks_Release = Benchmarks.exe

build obj/Benchmarks/Release/example.o: cxx_gcc ../benchmarks/example.cpp
  cxxflags = $cxxflags_Benchmarks_Release
build bin/Release/Benchmarks.exe: link_gcc obj/Benchmarks/Release/example.o
  ldflags = $ldflags_Benchmarks_Release
  links = $links_Benchmarks_Release

# Configuration: Benchmarks_Native

cflags_Benchmarks_Native = -m64 -O3 -g -Wall -Wextra -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -Ofast -march=native -mtune=native -fomit-frame-pointer -flto
cxxflags_Benchmarks_Native = -m64 -O3 -g -Wall -Wextra -std=c++26 -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -Ofast -march=native -mtune=native -fomit-frame-pointer -flto
ldflags_Benchmarks_Native = -m64 -L/usr/lib64
links_Benchmarks_Native = -lbenchmark -lbenchmark_main
objdir_Benchmarks_Native = obj/Benchmarks/Native
targetdir_Benchmarks_Native = bin/Native
target_Benchmarks_Native = Benchmarks.exe

build obj/Benchmarks/Native/example.o: cxx_gcc ../benchmarks/example.cpp
  cxxflags = $cxxflags_Benchmarks_Native
build bin/Native/Benchmarks.exe: link_gcc obj/Benchmarks/Native/example.o
  ldflags = $ldflags_Benchmarks_Native
  links = $links_Benchmarks_Native

# Build targets

build Benchmarks_Debug: phony bin/Debug/Benchmarks.exe
build Benchmarks_Release: phony bin/Release/Benchmarks.exe
build Benchmarks_Native: phony bin/Native/Benchmarks.exe

# Project phony targets

build Benchmarks: phony bin/Debug/Benchmarks.exe

