# Benchmarks project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule link_gcc
  command = g++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Benchmarks_Debug

cflags_Benchmarks_Debug = -m64 -O0 -g -Wall -Wextra -D"DEBUG" -IC:/msys64/ucrt64/include -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
cxxflags_Benchmarks_Debug = -m64 -O0 -g -Wall -Wextra -std=c++26 -D"DEBUG" -IC:/msys64/ucrt64/include -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
ldflags_Benchmarks_Debug = -m64 -LC:/msys64/ucrt64/bin/../lib -labsl_raw_hash_set -labsl_cord -labsl_cordz_info -labsl_cord_internal -labsl_cordz_functions -labsl_cordz_handle -labsl_crc_cord_state -labsl_crc32c -labsl_crc_internal -labsl_crc_cpu_detect -labsl_str_format_internal -labsl_hash -labsl_city -labsl_hashtablez_sampler -labsl_exponential_biased -labsl_synchronization -labsl_graphcycles_internal -labsl_kernel_timeout_internal -labsl_stacktrace -labsl_symbolize -ldbghelp -labsl_debugging_internal -labsl_demangle_internal -labsl_demangle_rust -labsl_decode_rust_punycode -labsl_utf8_for_code_point -labsl_malloc_internal -labsl_tracing_internal -labsl_time -labsl_civil_time -labsl_strings -labsl_strings_internal -labsl_int128 -labsl_base -ladvapi32 -labsl_spinlock_wait -labsl_source_location -labsl_time_zone -labsl_throw_delegate -labsl_raw_logging_internal -labsl_log_severity -LC:/msys64/ucrt64/lib -L/usr/lib64
links_Benchmarks_Debug = -lfmt -lbenchmark -lbenchmark_main
objdir_Benchmarks_Debug = obj/Benchmarks/Debug
targetdir_Benchmarks_Debug = bin/Debug
target_Benchmarks_Debug = Benchmarks.exe

build obj/Benchmarks/Debug/RegiserFileBenchmark.o: cxx_gcc ../benchmarks/RegiserFileBenchmark.cpp
  cxxflags = $cxxflags_Benchmarks_Debug
build bin/Debug/Benchmarks.exe: link_gcc obj/Benchmarks/Debug/RegiserFileBenchmark.o
  ldflags = $ldflags_Benchmarks_Debug
  links = $links_Benchmarks_Debug

