# Cpu project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule link_gcc
  command = g++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Cpu_Debug

cflags_Cpu_Debug = -m64 -O0 -g -D"DEBUG" -I../include
cxxflags_Cpu_Debug = -m64 -O0 -g -std=c++20 -D"DEBUG" -I../include
ldflags_Cpu_Debug = -m64 -L/usr/lib64
objdir_Cpu_Debug = obj/Debug
targetdir_Cpu_Debug = bin/Debug
target_Cpu_Debug = Cpu.exe

build obj/Debug/main.o: cxx_gcc ../src/main.cpp
  cxxflags = -m64 -O0 -g -std=c++20 -D"DEBUG" -I../include -Wall -Wextra -Wpedantic
build bin/Debug/Cpu.exe: link_gcc obj/Debug/main.o
  ldflags = $ldflags_Cpu_Debug

# Configuration: Cpu_Release

cflags_Cpu_Release = -m64 -O3 -g -D"NDEBUG" -I../include
cxxflags_Cpu_Release = -m64 -O3 -g -std=c++20 -D"NDEBUG" -I../include
ldflags_Cpu_Release = -m64 -L/usr/lib64
objdir_Cpu_Release = obj/Release
targetdir_Cpu_Release = bin/Release
target_Cpu_Release = Cpu.exe

build obj/Release/main.o: cxx_gcc ../src/main.cpp
  cxxflags = -m64 -O3 -g -std=c++20 -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic
build bin/Release/Cpu.exe: link_gcc obj/Release/main.o
  ldflags = $ldflags_Cpu_Release

# Build targets

build Cpu_Debug: phony bin/Debug/Cpu.exe
build Cpu_Release: phony bin/Release/Cpu.exe

# Project phony targets

build Cpu: phony bin/Debug/Cpu.exe

