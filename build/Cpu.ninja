# Cpu project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule link_gcc
  command = g++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Cpu_Debug

cflags_Cpu_Debug = -m64 -O0 -g -Wall -Wextra -D"DEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
cxxflags_Cpu_Debug = -m64 -O0 -g -Wall -Wextra -std=c++26 -D"DEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
ldflags_Cpu_Debug = -m64 -L/usr/lib64
objdir_Cpu_Debug = obj/Debug/Debug/Cpu
targetdir_Cpu_Debug = bin/Debug
target_Cpu_Debug = Cpu.exe

build obj/Debug/Debug/Cpu/main.o: cxx_gcc ../src/main.cpp
  cxxflags = $cxxflags_Cpu_Debug
build bin/Debug/Cpu.exe: link_gcc obj/Debug/Debug/Cpu/main.o
  ldflags = $ldflags_Cpu_Debug

# Configuration: Cpu_Release

cflags_Cpu_Release = -m64 -O3 -g -Wall -Wextra -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O3 -march=x86-64 -flto -mtune=native -fomit-frame-pointer
cxxflags_Cpu_Release = -m64 -O3 -g -Wall -Wextra -std=c++26 -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O3 -march=x86-64 -flto -mtune=native -fomit-frame-pointer
ldflags_Cpu_Release = -m64 -flto -L/usr/lib64
objdir_Cpu_Release = obj/Release/Release/Cpu
targetdir_Cpu_Release = bin/Release
target_Cpu_Release = Cpu.exe

build obj/Release/Release/Cpu/main.o: cxx_gcc ../src/main.cpp
  cxxflags = $cxxflags_Cpu_Release
build bin/Release/Cpu.exe: link_gcc obj/Release/Release/Cpu/main.o
  ldflags = $ldflags_Cpu_Release

# Configuration: Cpu_Native

cflags_Cpu_Native = -m64 -O3 -g -Wall -Wextra -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -Ofast -march=native -mtune=native -fomit-frame-pointer -flto
cxxflags_Cpu_Native = -m64 -O3 -g -Wall -Wextra -std=c++26 -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -Ofast -march=native -mtune=native -fomit-frame-pointer -flto
ldflags_Cpu_Native = -m64 -flto -L/usr/lib64
objdir_Cpu_Native = obj/Native/Native/Cpu
targetdir_Cpu_Native = bin/Native
target_Cpu_Native = Cpu.exe

build obj/Native/Native/Cpu/main.o: cxx_gcc ../src/main.cpp
  cxxflags = $cxxflags_Cpu_Native
build bin/Native/Cpu.exe: link_gcc obj/Native/Native/Cpu/main.o
  ldflags = $ldflags_Cpu_Native

# Build targets

build Cpu_Debug: phony bin/Debug/Cpu.exe
build Cpu_Release: phony bin/Release/Cpu.exe
build Cpu_Native: phony bin/Native/Cpu.exe

# Project phony targets

build Cpu: phony bin/Debug/Cpu.exe

