# Tests project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out -MD -MF $out.d
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule link_gcc
  command = g++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Tests_Debug

cflags_Tests_Debug = -m64 -O0 -g -Wall -Wextra -D"DEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
cxxflags_Tests_Debug = -m64 -O0 -g -Wall -Wextra -std=c++26 -D"DEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O0
ldflags_Tests_Debug = -m64 -L/usr/lib64
links_Tests_Debug = -lgtest -lgtest_main
objdir_Tests_Debug = obj/Debug/Debug/Tests
targetdir_Tests_Debug = bin/Debug
target_Tests_Debug = Tests.exe


# Configuration: Tests_Release

cflags_Tests_Release = -m64 -O3 -g -Wall -Wextra -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O3 -march=x86-64 -flto -mtune=native -fomit-frame-pointer
cxxflags_Tests_Release = -m64 -O3 -g -Wall -Wextra -std=c++26 -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -O3 -march=x86-64 -flto -mtune=native -fomit-frame-pointer
ldflags_Tests_Release = -m64 -flto -L/usr/lib64
links_Tests_Release = -lgtest -lgtest_main
objdir_Tests_Release = obj/Release/Release/Tests
targetdir_Tests_Release = bin/Release
target_Tests_Release = Tests.exe


# Configuration: Tests_Native

cflags_Tests_Native = -m64 -O3 -g -Wall -Wextra -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -Ofast -march=native -mtune=native -fomit-frame-pointer -flto
cxxflags_Tests_Native = -m64 -O3 -g -Wall -Wextra -std=c++26 -D"NDEBUG" -I../include -Wall -Wextra -Wpedantic -Wconversion -Wcast-align -Wunused -Wshadow -freflection -Ofast -march=native -mtune=native -fomit-frame-pointer -flto
ldflags_Tests_Native = -m64 -L/usr/lib64
links_Tests_Native = -lgtest -lgtest_main
objdir_Tests_Native = obj/Native/Native/Tests
targetdir_Tests_Native = bin/Native
target_Tests_Native = Tests.exe


# Build targets

build Tests_Debug: phony bin/Debug/Tests.exe
build Tests_Release: phony bin/Release/Tests.exe
build Tests_Native: phony bin/Native/Tests.exe

# Project phony targets

build Tests: phony bin/Debug/Tests.exe

