# Cpu workspace Ninja build file generated by Premake
ninja_required_version = 1.6

subninja Benchmarks.ninja
subninja Cpu.ninja

# Default build target
default Benchmarks_Debug Cpu_Debug

# Workspace configuration targets
build Debug: phony Benchmarks_Debug Cpu_Debug
build Native: phony Benchmarks_Native Cpu_Native
build Release: phony Benchmarks_Release Cpu_Release
